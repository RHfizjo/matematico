{
  "name": "matematico",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gra przeglądarkowa do nauki matematyki dla dzieci (PWA, three.js).",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "postprocessing": "^6.39.5",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.1",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
